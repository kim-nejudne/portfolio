# Everything the build does not need. Keeps the context small and stops a local
# node_modules or .next from shadowing what the image installs.
node_modules
**/node_modules
.next
**/.next
dist
**/dist
coverage
**/coverage
.git
.uploads
api/.artwork
api/.env
**/.env
**/.env.*
!**/.env.example
*.tsbuildinfo
**/*.tsbuildinfo
deploy
README.md
design_guidelines.md
