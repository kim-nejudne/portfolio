# Copy to api/.env for local development. Never commit the real file.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://forme:forme@localhost:5434/forme

# The API refuses to boot without this. Generate one:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-characters-of-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated. Must match the browser origin exactly or cookies are dropped.
WEB_ORIGIN=http://localhost:3000

# Artwork lands on a real disk. There is no blob store on the droplet.
ARTWORK_DIR=./.artwork
ARTWORK_MAX_BYTES=209715200
ARTWORK_RETENTION_DAYS=90

# ghostscript is CPU-bound and the droplet has two shared vCPUs.
PREFLIGHT_CONCURRENCY=1
PREFLIGHT_TIMEOUT_MS=120000

# Shared by every seeded demo account.
DEMO_PASSWORD=forme-demo-2026
