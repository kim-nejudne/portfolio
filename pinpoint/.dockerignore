# The image's build context is this app directory (scripts/docker-smoke.sh cds here). Keep agent
# files, secrets, local builds and docs out of it.
node_modules
dist
coverage
.git
.claude
CLAUDE.md
.env
.env.*
!.env.example
docs
*.log
# Local data and build output never enter the image: the build stage renders its own tiles.
.data
server/assets/fallback-tiles
.playtest
test-results
playwright-report
deploy
Dockerfile
.dockerignore
