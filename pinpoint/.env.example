# Every variable Pinpoint reads (spec: Milestones and acceptance criteria, Environment).
# Copy to .env for development. Never put a real key in this file.

# Listen port inside the container (development uses 3010, set by `npm run dev`).
PORT=
# categories.json, photos/ and generation-history.jsonl. Default ./.data (development), /app/data (production).
DATA_DIR=
# Express `trust proxy` setting: 1 behind nginx. Unset: off.
TRUST_PROXY=
# Join URL and QR. Default https://pinpoint.kimnejudne.dev
PUBLIC_URL=
# Admin sign-in: scrypt$N$r$p$salt$hash from `npm run admin:hash`. Unset disables /api/admin.
ADMIN_PASSWORD_HASH=
# Claude generation. Unset disables it.
PINPOINT_ANTHROPIC_API_KEY=
# CARTO dark_nolabels tiles. Unset uses the self-rendered fallback tiles.
PINPOINT_CARTO_KEY=
# Contact in the Wikimedia User-Agent; generation refuses to start while unset.
WIKIMEDIA_CONTACT=
# Levels per UTC day (default 20) and replacements/AI additions per UTC day (default 100).
GENERATE_DAILY_LIMIT=
GENERATE_REPLACE_DAILY_LIMIT=
# 1 swaps in the fake writer, checker and Wikimedia client (development, no network).
GENERATE_FAKE=
# Disk guard for photos/, in MB (default 1024).
PHOTOS_MAX_MB=
