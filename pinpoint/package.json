{
  "name": "pinpoint",
  "version": "0.1.0",
  "private": true,
  "description": "A geography party game: the TV shows a city or a landmark photo, everyone drops a pin on their phone's map, and the closest pin wins.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#shared/*": {
      "dist": "./dist/shared/*",
      "default": "./shared/*"
    }
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client --prefix-colors cyan,magenta \"NODE_ENV=development PORT=3010 tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node --conditions=dist dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playtest": "tsx scripts/playtest/run.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
