{
  // Server, shared code, scripts and tooling config, run by Node.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server",
    "shared",
    "scripts",
    "e2e",
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ]
}
