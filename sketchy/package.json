{
  "name": "sketchy",
  "version": "0.1.0",
  "private": true,
  "description": "A party drawing game: the Screen shows the live drawing, everyone guesses from their phones.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client --prefix-colors cyan,magenta \"NODE_ENV=development tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lan": "tsx scripts/lan.ts",
    "playtest": "tsx scripts/playtest/run.ts",
    "packs:check": "tsx scripts/packs-check.ts",
    "size": "tsx scripts/bundle.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "howler": "^2.2.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
