# Copy to api/.env for local development. Never commit the real file.
NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://suki:suki@localhost:5435/suki

# Every sync request must present this. The API refuses to start without it:
# a sync endpoint that accepts anonymous writes is one anyone can append to.
#   openssl rand -base64 48
DEVICE_KEY=change-me-to-at-least-32-characters-of-random

WEB_ORIGIN=http://localhost:3000
