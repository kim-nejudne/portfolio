# Copy to frontend/.env.local for local development.

# Where the sync API lives. Same origin in production, so nginx proxies /api.
VITE_API_URL=http://127.0.0.1:4100/api

# The shared device key, sent on every sync request.
#
# Be clear about what this is and is not. It ships inside the JS bundle, so it
# is not a secret — anyone who opens devtools has it. It is a coarse gate that
# keeps drive-by scanners and stray crawlers from appending to an append-only
# log, backed by rate limiting on both sync routes. It is NOT authentication,
# and this app deliberately has no accounts: SUKI is one shop's phone, and a
# sign-in screen between a shopkeeper and a sale she is making in front of a
# customer would be the wrong trade.
VITE_DEVICE_KEY=
