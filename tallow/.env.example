# Postgres connection string. Required — the server waits for a reachable
# database at boot rather than starting up and serving an empty menu.
DATABASE_URL="postgres://tallow:password@localhost:5432/tallow"

# Signs staff session tokens. Required, and the server exits at boot if unset:
# no secret means no session can be minted, so the dashboard would be
# unreachable anyway and failing loudly beats failing on first sign-in.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# PIN for a full staff session (reads and writes).
STAFF_PIN=""

# Optional. PIN for a read-only session, surfaced on the sign-in screen so a
# reviewer can tour the back of house without being able to change anything.
# Served by /api/admin/demo-hint rather than compiled into the client bundle,
# so rotating it does not require a rebuild. Omit to disable the demo tour.
DEMO_PIN=""

# Optional. Covers available per sitting window. Defaults to 16.
MAX_SLOT_COVERS="16"

# Optional. Defaults to 3000.
PORT="3000"
