# dependencies and build output
node_modules
dist
# the fixture course's build for Playwright (vite build --mode e2e)
dist-e2e
coverage
*.tsbuildinfo

# test runners
playwright-report
test-results

# secrets: this app has none, but nothing that looks like one is ever committed
.env*
!.env.example

# per-machine Claude Code settings; .claude/settings.json is the shared, committed one
.claude/settings.local.json

.DS_Store

# lib.*.d.ts copied from node_modules/typescript by scripts/copy-ts-libs.ts (spec §2); pnpm build regenerates it
public/ts/

# the pre-bundled packages (zod's runtime, zod's and React's types) written by scripts/copy-packages.ts (§12 F14); pnpm build regenerates them
public/packages/
