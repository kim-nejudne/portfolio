{
  "name": "ts-dojo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "copy-ts-libs": "node scripts/copy-ts-libs.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "spike:vim": "vite spike/vim --port 5179 --strictPort",
    "spike:vim:check": "playwright test -c spike/vim/playwright.config.ts"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@playwright/test": "1.64.1",
    "@replit/codemirror-vim": "6.4.0",
    "@types/node": "^24.19.2",
    "@typescript/vfs": "1.6.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
