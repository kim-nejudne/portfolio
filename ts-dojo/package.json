{
  "name": "ts-dojo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm copy-ts-libs && vite",
    "build": "pnpm copy-ts-libs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "bench": "vitest bench --run",
    "content:lint": "tsx scripts/content-lint.ts",
    "copy-ts-libs": "node scripts/copy-ts-libs.ts",
    "spike:vim": "vite spike/vim --port 5179 --strictPort",
    "spike:vim:check": "playwright test -c spike/vim/playwright.config.ts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@eslint/js": "9.39.5",
    "@lezer/highlight": "1.2.5",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.64.1",
    "@replit/codemirror-vim": "6.4.0",
    "@shikijs/twoslash": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/estree": "1.0.9",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/vfs": "1.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "16.5.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "prettier": "3.9.10",
    "remark-frontmatter": "5.0.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "twoslash": "0.3.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "dexie": "4.4.6",
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "shadcn": "4.21.5",
    "tw-animate-css": "1.4.0",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  }
}
